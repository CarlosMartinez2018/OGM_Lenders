# ─── AcentoPartners Email Classifier — Environment Config ────────────────────
# Copy this file to .env and fill in your values.
# cp .env.example .env

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Ollama LLM ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Set to true to run without Ollama (keyword-based mock classifier)
USE_MOCK_LLM=false

# ─── Email Paths ─────────────────────────────────────────────────────────────
SAMPLE_EMAILS_PATH=./sample_emails

# ─── Microsoft Graph API (Phase 2: Outlook Integration) ──────────────────────
# Register an app at https://portal.azure.com > App registrations
# Required permissions: Mail.Read (Application)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OUTLOOK_MAILBOX=waivers@acentopartners.com
# Polling interval in seconds (used by background service)
OUTLOOK_POLL_INTERVAL=60
